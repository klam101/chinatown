# Port the hub serves the app and API on
PORT=3000
# Kitchen printer on the local network (leave empty to print tickets to the console).
# First-run default only; change it later in the app's Settings screen.
PRINTER_HOST=
PRINTER_PORT=9100
# First-run defaults only: after the database exists, tax and printer are set in the app's Settings screen.
# Sales tax rate as a decimal, for example 0.08875
TAX_RATE=0
# Where the SQLite database file lives
# DB_PATH=/path/to/orders.db  (default: data/orders.db in the repo)
